Vehicle:
  type: branch
  description: vehicle branch

Vehicle.Implement:
  type: branch
  description: ISOBUS implements
  instances:
    - Implement[1,3]
  instances_relation: sibling

Vehicle.Implement.Count:
  type: attribute
  datatype: uint8
  description: Number of active implements
  instantiate: false

Vehicle.Impement.Connector:
  type: branch
  description: Connector of ISOBUS implement

Vehicle.Implement.Connector.InstantiatedValue:
  type: sensor
  description: Some sensor value on a connector
  datatype: float

Vehicle.Implement.Connector.NotInstantiatedValue:
  type: sensor
  description: Some sensor value on a connector
  datatype: float
  instantiate: false

Vehicle.Implement.Boom:
  type: branch
  description: Booms of ISOBUS implements
  instances:
    - Boom[1,2]
  instances_relation: sibling

Vehicle.Implement.Boom.Count:
  type: attribute
  datatype: uint8
  description: Number of active booms
  instantiate: false

Vehicle.Implement.Boom.Section:
  type: branch
  description: Sections on an ISOBUS boom
  instances:
    - Section[1,32]
  instances_relation: sibling

Vehicle.Implement.Boom.Section.Count:
  type: attribute
  datatype: uint8
  description: Number of active sections
  instantiate: false

Vehicle.Implement.Boom.Channel:
  type: branch
  description: Channels on an ISOBUS boom
  instances:
    - Channel[1,32]
  instances_relation: sibling

Vehicle.Implement.Boom.Channel.Count:
  type: attribute
  datatype: uint8
  description: Number of active channels
  instantiate: false

Vehicle.Implement.Boom.Channel.Subchannel:
  type: branch
  description: Subchannels of an ISOBUS channel
  instances:
    - Channel[1,8]
  instances_relation: sibling

Vehicle.Implement.Boom.Channel.Subchannel.Count:
  type: attribute
  datatype: uint8
  description: Number of active subchannels
  instantiate: false

Vehicle.Speed:
  datatype: float
  type: sensor
  unit: km/h
  min: 0.0
  description: Vehicle speed.
  comment: Vehicle speed is the magnitude of the velocity vector. It is a scalar quantity and is always non-negative. The unit of measurement is kilometers per hour (km/h).

Vehicle.Type:
  datatype: uint8
  type: attribute
  description: Type of vehicle
  min: 0
  max: 10
  comment: Vehicle type 

